{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/abi.ts",
    "src/db-execute.ts",
    "src/db-value.ts",
    "src/env.ts",
    "src/generated.ts",
    "src/plugin.ts",
    "src/workerd.ts",
    "src/sparse-workerd/index.ts",
    "src/testkit.ts",
    "src/cli.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "../../target/api-docs/typescript",
  "name": "@bookclerk/plugin-sdk",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeExternals": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatValidationWarningsAsErrors": true,
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "TypeAlias"
  ]
}
