{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "docs": "typedoc --options typedoc.json",
    "test": "vitest run",
    "test:safe-html": "node scripts/check-safe-html.mjs",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --quiet --output-dir storybook-static",
    "test:visual": "playwright test --config visual/playwright.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "email-validator": "^2.0.4",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "glob": "14.0.3"
  }
}
