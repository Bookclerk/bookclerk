{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookclerk.dev/schemas/plugin-toml.json",
  "title": "BookclerkPluginToml",
  "description": "Install descriptor for a Bookclerk plugin (plugin.toml), api_version = 3. Keys use TOML/snake_case. There is no plugin `kind`; handler family is derived from entrypoints and triggers. The `id` is a display/CLI alias, not a globally unique security identity. Durable identity is the host-computed provenance-qualified PluginKey. capabilities.network.domains is workerd-only (hostname allowlist for isolate fetch()). Native guests omit domains and declare capabilities.network.tcp for mediated connect(); ambient AF_INET is denied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "capabilities"],
  "properties": {
    "api_version": { "type": "integer", "enum": [3] },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "description": "Display / CLI alias. Not globally unique and not a privilege. Lowercase letters, digits, and single underscores only (2–32 chars); no leading/trailing or doubled `_`. When two installs share an alias, address them with a provenance-qualified PluginKey."
    },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "logo": {
      "type": "string",
      "description": "Optional Settings/UI logo: https:// or http:// URL (browser loads directly), or a relative image path under the plugin install root (host serves via GET /api/plugins/{id}/logo when the alias is unambiguous). Embedded paths must not contain '..' and must end with .png/.jpg/.jpeg/.gif/.webp/.svg/.ico."
    },
    "runtime": {
      "type": "string",
      "enum": ["native", "workerd"],
      "default": "native"
    },
    "command": { "type": "string", "minLength": 1 },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entrypoints": {
      "type": "array",
      "description": "Named capabilities this plugin exports from PluginWorker.open.",
      "items": {
        "type": "string",
        "enum": ["storefront", "storage", "databaseAdapter", "remoteLibrary", "cli", "oidc"]
      }
    },
    "workerd": { "$ref": "#/$defs/WorkerdRuntime" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleSpec" }
    },
    "triggers": { "$ref": "#/$defs/Triggers" },
    "events": { "$ref": "#/$defs/Events" },
    "databases": {
      "type": "array",
      "description": "Named plugin-owned database bindings (Workers-style).",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/DatabaseBinding" }
    },
    "vars": {
      "type": "object",
      "description": "Operator config binding defaults (`CONFIG`). An empty table still declares the binding."
    },
    "secrets": { "$ref": "#/$defs/NamedBinding" },
    "kv_namespaces": {
      "type": "array",
      "description": "Durable KV bindings (default name KV). Legal to declare. Load and spawn fail with \"not implemented yet\". Distinct from [[databases]].",
      "items": { "$ref": "#/$defs/NamedBinding" }
    },
    "queues": {
      "type": "object",
      "description": "Workers Queues producers and consumers. Legal to declare. Load and spawn fail with \"not implemented yet\". Events and databases do not replace this surface."
    },
    "work_fs": { "$ref": "#/$defs/NamedBinding" },
    "oauth": { "$ref": "#/$defs/NamedBinding" },
    "capabilities": { "$ref": "#/$defs/Capabilities" },
    "cli": { "$ref": "#/$defs/CliSchema" },
    "oidc": { "$ref": "#/$defs/OidcManifest" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runtime": { "const": "workerd" } },
        "required": ["runtime"]
      },
      "then": { "required": ["workerd"] }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "runtime": { "const": "native" } } },
          { "not": { "required": ["runtime"] } }
        ]
      },
      "then": {
        "required": ["command"],
        "properties": {
          "capabilities": {
            "properties": {
              "network": {
                "properties": {
                  "domains": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": { "const": "workerd" },
          "capabilities": {
            "properties": {
              "network": {
                "properties": { "mode": { "const": "outbound" } },
                "required": ["mode"]
              }
            },
            "required": ["network"]
          }
        },
        "required": ["runtime", "capabilities"]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "network": {
                "required": ["domains"],
                "properties": {
                  "domains": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network"],
      "properties": {
        "network": { "$ref": "#/$defs/NetworkCapabilities" }
      }
    },
    "NetworkCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["deny", "outbound"] },
        "domains": {
          "type": "array",
          "description": "Workerd-only: initial-request host allowlist for isolate egress. Forbidden on runtime=native. The operator may add destinations beyond this list; the guest cannot.",
          "items": { "type": "string", "minLength": 1 }
        },
        "tcp": {
          "type": "array",
          "description": "Raw TCP connect grants (host + ports). Fetch domain grants do not imply TCP.",
          "items": { "$ref": "#/$defs/TcpCapability" }
        },
        "allow_undeclared_public_redirects": {
          "type": "boolean",
          "description": "When true, fetch redirects may target undeclared public hosts. Address-space policy still applies."
        },
        "address_cidrs": {
          "type": "array",
          "description": "Explicit CIDR grants beyond the public Internet. No blanket private=true.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "TcpCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "ports"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "minItems": 1
        }
      }
    },
    "Triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/EventConsumer" }
        },
        "producers": {
          "type": "array",
          "items": { "$ref": "#/$defs/EventProducer" }
        }
      }
    },
    "EventConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "schema_versions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        },
        "supports_suspend": { "type": "boolean", "default": false },
        "resource_class": { "type": "string", "enum": ["network"], "default": "network" },
        "filter": { "type": "object" },
        "max_retries": { "type": "integer", "minimum": 0 }
      }
    },
    "EventProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "binding": { "type": "string", "minLength": 1 }
      }
    },
    "DatabaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding"],
      "properties": {
        "binding": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 32
        }
      }
    },
    "NamedBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string", "minLength": 1 }
      }
    },
    "WorkerdRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_date", "main_module"],
      "properties": {
        "compatibility_date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar YYYY-MM-DD. A date newer than the pinned workerd compatibility date 2026-08-01 warns and falls back to that pin when the isolate loads."
        },
        "compatibility_flags": {
          "type": "array",
          "description": "Exact allowlist: python_workers and disable_python_external_sdk. Both are required together when the guest is Python and forbidden otherwise. The host does not append missing flags.",
          "items": {
            "type": "string",
            "enum": ["python_workers", "disable_python_external_sdk"]
          }
        },
        "main_module": { "type": "string", "minLength": 1 },
        "modules_dir": { "type": "string", "default": "modules" },
        "entrypoint": { "type": "string", "default": "default" },
        "limits": { "$ref": "#/$defs/WorkerdLimits" }
      }
    },
    "WorkerdLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_ms": { "type": "integer", "minimum": 0 },
        "subrequests": { "type": "integer", "minimum": 0 }
      }
    },
    "ModuleSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Source file relative to the plugin root. When path is omitted or empty, name is the modules-directory source."
        },
        "type": { "type": "string", "default": "js" }
      }
    },
    "CliSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CliCommandSpec" }
        }
      }
    },
    "CliCommandSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "about": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/CliArgSpec" }
        }
      }
    },
    "CliArgSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "long": { "type": "string" },
        "short": { "type": "string", "maxLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["string", "bool", "int", "path"],
          "default": "string"
        },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "about": { "type": "string" },
        "positional": { "type": "boolean" }
      }
    },
    "OidcManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clients": {
          "type": "array",
          "items": { "$ref": "#/$defs/OidcClient" }
        }
      }
    },
    "OidcClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "callback_path", "origin_config_key"],
      "properties": {
        "client_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string" },
        "callback_path": { "type": "string", "pattern": "^/" },
        "public_client": { "type": "boolean", "default": true },
        "default_scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "issue_refresh_token": { "type": "boolean", "default": true },
        "origin_config_key": { "type": "string", "minLength": 1 }
      }
    }
  }
}
