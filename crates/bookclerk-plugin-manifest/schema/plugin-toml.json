{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookclerk.dev/schemas/plugin-toml.json",
  "title": "BookclerkPluginToml",
  "description": "Install descriptor for a Bookclerk plugin (plugin.toml). Keys use TOML/snake_case naming. capabilities.network.domains is workerd-only (hostname allowlist inside the isolate). Native outbound is coarse jail networking with no domain filter — do not declare domains on native plugins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "kind", "capabilities"],
  "properties": {
    "api_version": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "description": "Globally unique across kinds. Lowercase letters, digits, and single underscores only (2–32 chars); no leading/trailing or doubled `_`."
    },
    "name": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["source", "integration", "output", "database"]
    },
    "version": { "type": "string" },
    "logo": {
      "type": "string",
      "description": "Optional Settings/UI logo: https:// or http:// URL (browser loads directly), or a relative image path under the plugin install root (host serves via GET /api/plugins/{kind}/{id}/logo). Embedded paths must not contain '..' and must end with .png/.jpg/.jpeg/.gif/.webp/.svg/.ico."
    },
    "runtime": {
      "type": "string",
      "enum": ["native", "workerd"],
      "default": "native"
    },
    "command": { "type": "string", "minLength": 1 },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workerd": { "$ref": "#/$defs/WorkerdRuntime" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/ModuleSpec" }
    },
    "capabilities": { "$ref": "#/$defs/Capabilities" },
    "cli": { "$ref": "#/$defs/CliSchema" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runtime": { "const": "workerd" } },
        "required": ["runtime"]
      },
      "then": { "required": ["workerd"] }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "runtime": { "const": "native" } } },
          { "not": { "required": ["runtime"] } }
        ]
      },
      "then": {
        "required": ["command"],
        "properties": {
          "capabilities": {
            "properties": {
              "network": {
                "properties": {
                  "domains": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": { "const": "workerd" },
          "capabilities": {
            "properties": {
              "network": {
                "properties": { "mode": { "const": "outbound" } },
                "required": ["mode"]
              }
            },
            "required": ["network"]
          }
        },
        "required": ["runtime", "capabilities"]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "network": {
                "required": ["domains"],
                "properties": {
                  "domains": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network"],
      "properties": {
        "network": { "$ref": "#/$defs/NetworkCapabilities" },
        "bindings": { "$ref": "#/$defs/BindingCapabilities" },
        "methods": { "$ref": "#/$defs/MethodCapabilities" }
      }
    },
    "NetworkCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["deny", "outbound"] },
        "domains": {
          "type": "array",
          "description": "Workerd-only: initial-request host allowlist for isolate egress. Forbidden on runtime=native.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "BindingCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": { "type": "boolean" },
        "secrets": { "type": "boolean" },
        "plugin_kv": { "type": "boolean" },
        "work_fs": { "type": "boolean" },
        "oauth": { "type": "boolean" }
      }
    },
    "MethodCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "WorkerdRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_date", "main_module"],
      "properties": {
        "compatibility_date": { "type": "string", "minLength": 1 },
        "compatibility_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "main_module": { "type": "string", "minLength": 1 },
        "modules_dir": { "type": "string", "default": "modules" },
        "entrypoint": { "type": "string", "default": "default" },
        "limits": { "$ref": "#/$defs/WorkerdLimits" }
      }
    },
    "WorkerdLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_ms": { "type": "integer", "minimum": 0 },
        "subrequests": { "type": "integer", "minimum": 0 }
      }
    },
    "ModuleSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "type": { "type": "string", "default": "js" }
      }
    },
    "CliSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/CliCommandSpec" }
        }
      }
    },
    "CliCommandSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "about": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/CliArgSpec" }
        }
      }
    },
    "CliArgSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "long": { "type": "string" },
        "short": { "type": "string", "maxLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["string", "bool", "int", "path"],
          "default": "string"
        },
        "required": { "type": "boolean" },
        "default": { "type": "string" },
        "about": { "type": "string" },
        "positional": { "type": "boolean" }
      }
    }
  }
}
