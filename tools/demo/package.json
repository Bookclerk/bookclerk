{
  "name": "bookclerk-demo",
  "private": true,
  "description": "Bookclerk hosted demo Worker: one Cloudflare Container per visitor",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint --deny-warnings",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "26.6.5",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
