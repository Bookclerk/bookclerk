{
  "name": "bookclerk-demo",
  "private": true,
  "description": "Bookclerk hosted demo Worker: one Cloudflare Container per visitor",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
