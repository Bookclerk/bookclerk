{
  "name": "bookclerk-demo",
  "private": true,
  "description": "Bookclerk hosted demo Worker: one Cloudflare Container per visitor",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
