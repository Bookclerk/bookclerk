# Headers for the dashboard's static files (served without the Worker).
/static/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000

# Font files carry their upstream version in the name (see fonts/README.md).
/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable
