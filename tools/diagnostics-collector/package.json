{
  "name": "bookclerk-diagnostics",
  "private": true,
  "description": "Bookclerk diagnostics Worker (Cloudflare Builds)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
