{
  "name": "bookclerk-site",
  "private": true,
  "description": "The bookclerk.app website and documentation: static pages served by a Cloudflare Worker",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "node --test api-reference.test.ts build.test.ts diagram.test.ts docs.test.ts fuzz.test.ts worker.test.ts",
    "deploy": "wrangler deploy",
    "dev": "node build.ts && wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "beautiful-mermaid": "1.1.3",
    "markdown-it": "^15.0.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
