{
  "name": "bookclerk-site",
  "private": true,
  "description": "The bookclerk.app website and documentation: static pages served by a Cloudflare Worker",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc -p .",
    "test": "node --test build.test.ts docs.test.ts fuzz.test.ts worker.test.ts",
    "deploy": "wrangler deploy",
    "dev": "node build.ts && wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "markdown-it": "^15.0.3",
    "typescript": "6.0.3",
    "wrangler": "^4.151.0"
  }
}
