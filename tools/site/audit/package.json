{
  "name": "bookclerk-site-audit",
  "private": true,
  "description": "Lighthouse and axe-core audit of the bookclerk.app website, run by CI against a local wrangler dev server",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "audit": "node audit.ts",
