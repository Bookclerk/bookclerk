# Generated by Cargo
/target/
/target-docker/
# Workspace-local Cargo home (registry + git). Set CARGO_HOME=$PWD/.cargo-home
# (see .envrc / Dev Container / AGENTS.md). Do not put this under `.cargo/`.
/.cargo-home/
# Build-script / cc temp files (aws-lc, etc.) when TMPDIR points here.
/.tmp/*
!/.tmp/.gitkeep
**/*.rs.bk
Cargo.lock.bak

# Frontend
ui/node_modules/
ui/dist/
ui/*.local

# TypeScript packages / examples
packages/**/node_modules/
packages/**/dist/
examples/**/dist/
examples/**/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local data / secrets
.env
.env.*
!.env.example
*.auth
*.auth.json
config.local.toml

# Bookclerk / runtime data
BookclerkFiles/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
# workerd materialize artifacts (smoke / bookclerk-workerd)
**/.bookclerk/
**/.bookclerk-workerd-config.capnp

# Coverage / tooling
coverage/
lcov.info
*.profraw
.venv/
.venv-*/
*.egg-info/
**/*.egg-info/

# Local APK probe outputs (CI uploads these as artifacts)
/artifacts/
**/__pycache__/
*.py[cod]

# Vendored crate build outputs
third_party/**/target/
