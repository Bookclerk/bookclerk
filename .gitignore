# Generated by Cargo
/target/
# Workspace-local Cargo home (registry + git). The Dev Container sets
# CARGO_HOME=<workspace>/.cargo-home; local hosts use the default ~/.cargo.
# Do not put this under `.cargo/`.
/.cargo-home/
# Former workspace TMPDIR; safe to delete in old checkouts.
/.tmp/
**/*.rs.bk
Cargo.lock.bak
# Standalone author-surface fixture packages (scripts/check-author-surface.sh)
# resolve their own lockfiles; only the workspace Cargo.lock is committed.
tools/author-surface-check/*/Cargo.lock

# Frontend
ui/node_modules/
ui/dist/
ui/*.local

# TypeScript packages / examples
packages/**/node_modules/
packages/**/dist/
examples/**/dist/
examples/**/node_modules/

# IDE (only shared extension recommendations are committed)
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local data / secrets
.env
.env.*
!.env.example
# Local direnv overlay, if present. Never commit `.envrc`.
.envrc
*.auth
*.auth.json
config.local.toml

# Bookclerk / runtime data
BookclerkFiles/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
# workerd materialize artifacts (smoke / bookclerk-workerd)
**/.bookclerk/
**/.bookclerk-workerd-config.capnp
packages/plugin-sdk-python/**/.workerd-cache/
scripts/librofm-apk-probe/_smoke_keep/

# Coverage / tooling
coverage/
lcov.info
*.profraw
.venv/
.venv-*/
*.egg-info/
**/*.egg-info/

# Generated API reference HTML (see docs/api/README.md / scripts/generate-api-docs.sh)
/docs/api/rust/
/docs/api/typescript/
/docs/api/ui/
/docs/api/python/

# Local APK probe outputs (CI uploads these as artifacts)
/artifacts/
**/__pycache__/
*.py[cod]

# Vendored crate build outputs
third_party/**/target/

# cargo-fuzz build products (checked-in corpora stay under fuzz/corpus/)
fuzz/target/
fuzz/artifacts/
