{
  "build": {
    "dockerfile": "../.devcontainer/Dockerfile",
    "context": ".."
  },
  "install": "./.cursor/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "bookclerkd",
      "command": "cargo dev --skip-build",
      "description": "bookclerkd after warm platform build (listens on 8787)"
    }
  ],
  "ports": [
    {
      "name": "bookclerkd",
      "port": 8787
    }
  ]
}
