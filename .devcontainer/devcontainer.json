{
  "name": "Bookclerk",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "bookclerk",
  "updateRemoteUserUID": true,
  "forwardPorts": [8787, 5173],
  "portsAttributes": {
    "8787": {
      "label": "bookclerkd",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "Vite UI",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "CARGO_TERM_COLOR": "always"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/target/debug:${containerWorkspaceFolder}/target/release:${containerEnv:PATH}",
    "CARGO_HOME": "${containerWorkspaceFolder}/.cargo-home",
    "CARGO_TARGET_DIR": "${containerWorkspaceFolder}/target",
    "TMPDIR": "${containerWorkspaceFolder}/.tmp",
    "BOOKCLERK_FILES_DIR": "${containerWorkspaceFolder}/BookclerkFiles",
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
    "GIT_COMMITTER_NAME": "${localEnv:GIT_COMMITTER_NAME}",
    "GIT_COMMITTER_EMAIL": "${localEnv:GIT_COMMITTER_EMAIL}",
    "GIT_SSH_SIGNING_PUBKEY": "${localEnv:GIT_SSH_SIGNING_PUBKEY}"
  },
  "postCreateCommand": "bash -lc 'mkdir -p .cargo-home .tmp BookclerkFiles && cargo fetch && (cd ui && npm ci)'",
  "postStartCommand": "bash .devcontainer/git-signing.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.allFeatures": false,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  }
}
