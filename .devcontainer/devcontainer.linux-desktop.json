{
  "name": "Bookclerk (Linux desktop + tray)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "bookclerk",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--security-opt=apparmor=unconfined",
    "--security-opt=label=disable"
  ],
  "forwardPorts": [8787, 5173],
  "portsAttributes": {
    "8787": {
      "label": "bookclerkd",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "Vite UI",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR},target=/run/host-user,type=bind",
    "source=${localEnv:XDG_RUNTIME_DIR}/bus,target=/run/host-user/bus,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "CARGO_TERM_COLOR": "always",
    "XDG_RUNTIME_DIR": "/run/host-user",
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/host-user/bus",
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/target/debug:${containerWorkspaceFolder}/target/release:${containerEnv:PATH}",
    "CARGO_HOME": "${containerWorkspaceFolder}/.cargo-home",
    "CARGO_TARGET_DIR": "${containerWorkspaceFolder}/target",
    "TMPDIR": "${containerWorkspaceFolder}/.tmp",
    "BOOKCLERK_FILES_DIR": "${containerWorkspaceFolder}/BookclerkFiles"
  },
  "postCreateCommand": "bash -lc 'mkdir -p .cargo-home .tmp BookclerkFiles && cargo fetch && (cd ui && npm ci)'",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.allFeatures": false,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  }
}
